# =============================================================================
# TWS Laravel Starter Kit — .env.example (DESENVOLVIMENTO via Docker)
#
# Copie para .env e ajuste. NUNCA commitar o .env real (gitignored).
# Em produção: APP_ENV=production, APP_DEBUG=false e segredos reais.
# =============================================================================

# --- Aplicação ----------------------------------------------------------------
APP_NAME="TWS Starter Kit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Em dev via Docker, o nginx publica na 8180 do host.
APP_URL=http://localhost:8180

# Idioma padrão da plataforma: pt-BR (ADR-007). Multi-idioma preparado via lang/.
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

# Hash de senhas (checklist item 4): argon2id — o mais forte disponível
# (vencedor do PHC; resistente a GPU/ASIC por consumo de memória).
# Aplica-se à senha de login E à senha de transação (ADR-006).
HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4

# --- Autenticação (Fase 3 — ADR-006/010) --------------------------------------
# Força mínima das senhas.
AUTH_PASSWORD_MIN=12
AUTH_TRANSACTION_PASSWORD_MIN=8
# Bloqueio de login: tentativas e duração do bloqueio.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_MINUTES=15
# Código de verificação (2FA por e-mail): validade, tentativas, cooldown.
AUTH_VERIFICATION_CHANNEL=email
AUTH_VERIFICATION_CODE_TTL_MINUTES=10
AUTH_VERIFICATION_CODE_MAX_ATTEMPTS=5
AUTH_VERIFICATION_CODE_RESEND_COOLDOWN_SECONDS=60
# Token de ação sensível (uso único): validade em minutos.
AUTH_SENSITIVE_TOKEN_TTL_MINUTES=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Plataforma (ADR-007 — config centralizada; NUNCA hardcodar no código) ----
# Nome público da plataforma (telas, e-mails, metadados).
PLATFORM_NAME="TWS Starter Kit"
# URL do logotipo oficial (vazio = sem logo).
PLATFORM_LOGO_URL=
# URL institucional oficial.
PLATFORM_OFFICIAL_URL=http://localhost:8180
# E-mail público de suporte.
PLATFORM_SUPPORT_EMAIL=suporte@example.com
# CNPJ da empresa operadora (rodapés, termos). Vazio até existir.
PLATFORM_CNPJ=
# Locale/formatos da plataforma.
PLATFORM_LOCALE=pt_BR
# Timezone de EXIBIÇÃO (internamente tudo é UTC — ADR-010).
PLATFORM_DISPLAY_TIMEZONE=America/Sao_Paulo
# Moeda padrão (multi-moeda preparado: valor + moeda — ADR-004).
PLATFORM_CURRENCY=BRL

# --- Banco de dados (PostgreSQL 18 em container) ------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=tws_starter
DB_USERNAME=tws
DB_PASSWORD=tws_dev_password

# --- Sessão / cache / filas (Redis 8 em container) ----------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- E-mail (Mailpit em dev: SMTP 1025, caixa de entrada web na 8025) --------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${PLATFORM_NAME}"

# --- Storage externo S3-compatível (Cloudflare R2 — ADR-010) ------------------
# Em dev pode ficar vazio (FILESYSTEM_DISK=local). Preencher ao habilitar R2:
# endpoint = https://<accountid>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Segurança HTTP e logs de requisição (ADR-004/005/010) --------------------
# Headers de segurança OWASP (config/security.php).
SECURITY_HEADERS_ENABLED=true
# CSP básica — endurecer em produção (remover 'unsafe-inline' com nonces).
# SECURITY_CSP=
# HSTS: enviado só sob HTTPS. Padrão: ligado quando APP_ENV=production.
# SECURITY_HSTS_ENABLED=

# Rate limiting (requisições por minuto, por usuário autenticado ou IP).
RATE_LIMIT_API=60
RATE_LIMIT_SENSITIVE=5

# CORS restritivo: origens permitidas separadas por vírgula.
# Vazio = NENHUMA origem (API server-to-server). Liberar só as origens dos painéis.
CORS_ALLOWED_ORIGINS=
CORS_MAX_AGE=600

# Rotas excluídas do request log em banco (health checks — seguem no access log
# do nginx). Separadas por vírgula, padrão do Request::is().
REQUEST_LOG_EXCLUDED_PATHS=up,api/health
# Dias de retenção do canal de arquivo storage/logs/request-YYYY-MM-DD.log.
REQUEST_LOG_DAYS=30

VITE_APP_NAME="${PLATFORM_NAME}"

# =============================================================================
# TWS Laravel Starter Kit — .env.example (DESENVOLVIMENTO via Docker)
#
# Copie para .env e ajuste. NUNCA commitar o .env real (gitignored).
# Em produção: APP_ENV=production, APP_DEBUG=false e segredos reais.
#
# ESTE ARQUIVO É DE DESENVOLVIMENTO e traz a demonstração do kit LIGADA (login
# demo com credenciais conhecidas, super admin demo, vitrine /ui, galeria
# /mail-preview). Copiá-lo para um servidor NÃO abre nada disso: com
# APP_ENV=production a superfície de demonstração é recusada independentemente
# das flags abaixo, e o APP_DEBUG é forçado para false. Ver a seção "Landing
# pública, showcase /ui e login demo" no fim do arquivo.
# =============================================================================

# --- Aplicação ----------------------------------------------------------------
APP_NAME="TWS Starter Kit"
APP_ENV=local
# Gerar com `php artisan key:generate` (o README, passo 3, mostra no container).
# Em PRODUÇÃO a chave é pré-requisito: o entrypoint da imagem aborta e a
# aplicação recusa o boot se ela faltar, em vez de gerar uma — chave gerada na
# subida é diferente em cada container e não sobrevive ao restart. Trocar a
# chave de uma instalação com dado é IRREVERSÍVEL sem a antiga; ver
# APP_PREVIOUS_KEYS no .env.prod.example.
APP_KEY=
# Em DESENVOLVIMENTO o debug fica ligado: sem ele todo erro local vira uma tela
# branca, e quem precisa depurar apenas religa a variável. A proteção contra
# levar isto para produção NÃO é este valor — é o runtime: com
# APP_ENV=production a aplicação força app.debug=false e grava um aviso no log
# (AppServiceProvider). O docker-compose.prod.yml também injeta false.
APP_DEBUG=true
# Em dev via Docker, o nginx publica na 8180 do host.
APP_URL=http://localhost:8180

# Idioma padrão da plataforma: pt-BR (ADR-007). Multi-idioma preparado via lang/.
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

# Hash de senhas (checklist item 4): argon2id — o mais forte disponível
# (vencedor do PHC; resistente a GPU/ASIC por consumo de memória).
# Aplica-se à senha de login E à senha de transação (ADR-006).
HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4

# --- Autenticação (Fase 3 — ADR-006/010) --------------------------------------
# Política da senha de LOGIN (config/auth.php → password_rules). Padrão do
# kit: só o tamanho mínimo. Para endurecer, descomente o que quiser exigir —
# validação, dicas dos formulários e mensagens de erro acompanham sozinhas.
AUTH_PASSWORD_MIN=6
#AUTH_PASSWORD_LETTERS=true        # pelo menos uma letra
#AUTH_PASSWORD_MIXED_CASE=true     # maiúscula E minúscula
#AUTH_PASSWORD_NUMBERS=true        # pelo menos um número
#AUTH_PASSWORD_SYMBOLS=true        # pelo menos um símbolo
#AUTH_PASSWORD_UNCOMPROMISED=true  # recusa senha vazada (Have I Been Pwned)
# Senha de TRANSAÇÃO (política própria, só tamanho).
AUTH_TRANSACTION_PASSWORD_MIN=8
# Bloqueio de login: tentativas e duração do bloqueio.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_MINUTES=15
# Código de verificação (2FA por e-mail): validade, tentativas, cooldown.
AUTH_VERIFICATION_CHANNEL=email
AUTH_VERIFICATION_CODE_TTL_MINUTES=10
AUTH_VERIFICATION_CODE_MAX_ATTEMPTS=5
AUTH_VERIFICATION_CODE_RESEND_COOLDOWN_SECONDS=60
# Token de ação sensível (uso único): validade em minutos.
AUTH_SENSITIVE_TOKEN_TTL_MINUTES=10

# --- Chaves de API + Tenancy (Fase 4 — ADR-006/010) ---------------------------
# Ambiente das chaves geradas: live (pk_live_/sk_live_) ou test (pk_test_...).
API_KEYS_ENVIRONMENT=test
# Pepper do hash HMAC-SHA256 da chave secreta (vazio = usa a APP_KEY).
# Em produção, defina um segredo dedicado: php artisan tinker → Str::random(64)
API_KEYS_HASH_PEPPER=
# Atualização do last_used_at: no máximo 1 escrita a cada N segundos por chave.
API_KEYS_LAST_USED_THROTTLE_SECONDS=60
# Expiração por inatividade: desativa após N meses sem uso, com aviso prévio
# por e-mail Y dias antes (job diário api-keys:process-inactivity).
API_KEYS_INACTIVITY_ENABLED=true
API_KEYS_INACTIVITY_MONTHS=3
API_KEYS_INACTIVITY_WARNING_DAYS=7
# Rotação: teto do grace period (morte programada da chave antiga), em minutos.
API_KEYS_MAX_GRACE_MINUTES=10080
# Itens por página nas listagens da API v1.
API_KEYS_PER_PAGE=15

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Plataforma (ADR-007 — config centralizada; NUNCA hardcodar no código) ----
# Nome público da plataforma (telas, e-mails, metadados).
PLATFORM_NAME="TWS Starter Kit"
# URL do logotipo oficial (vazio = sem logo).
PLATFORM_LOGO_URL=
# URL institucional oficial.
PLATFORM_OFFICIAL_URL=http://localhost:8180
# URL pública do repositório (CTA "ver o código" da landing).
PLATFORM_REPO_URL=https://github.com/kelvindk9w/tws-laravel-starter-kit
# E-mail que recebe as mensagens do formulário de contato da landing.
# Em dev, visível no Mailpit (http://localhost:18025).
PLATFORM_CONTACT_EMAIL=contato@example.com
# Empresa operadora (rodapé: direitos autorais e "desenvolvido por").
PLATFORM_COMPANY_NAME=TWS
PLATFORM_COMPANY_URL=https://example.com
# E-mail público de suporte.
PLATFORM_SUPPORT_EMAIL=suporte@example.com
# CNPJ da empresa operadora (rodapés, termos). Vazio até existir.
PLATFORM_CNPJ=
# Override OPCIONAL da cor primária da marca (hex) — painel do usuário e
# super admin. Vazio (padrão) = identidade monocromática dos tokens
# (theme.css: preto no tema claro, branco no escuro — esquema Vercel/Linear).
# PLATFORM_PRIMARY_COLOR="#0284C7"
# Versão da plataforma (exibida no GET /api/health e metadados).
PLATFORM_VERSION=0.2.0
# Locale/formatos da plataforma.
PLATFORM_LOCALE=pt_BR
# Idiomas disponíveis no seletor (vírgula). Cada um precisa de lang/<locale>/.
# PLATFORM_AVAILABLE_LOCALES=pt_BR,en,es
# Timezone de EXIBIÇÃO (internamente tudo é UTC — ADR-010).
PLATFORM_DISPLAY_TIMEZONE=America/Sao_Paulo
# Moeda padrão (multi-moeda preparado: valor + moeda — ADR-004).
PLATFORM_CURRENCY=BRL

# --- Banco de dados (PostgreSQL 18 em container) ------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=tws_starter
DB_USERNAME=tws
DB_PASSWORD=tws_dev_password

# --- Sessão / cache / filas (Redis 8 em container) ----------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- E-mail (Mailpit em dev: SMTP 1025, caixa de entrada web na 8025) --------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${PLATFORM_NAME}"

# --- Storage externo S3-compatível (Cloudflare R2 — ADR-010) ------------------
# Em dev pode ficar vazio (FILESYSTEM_DISK=local). Preencher ao habilitar R2:
# endpoint = https://<accountid>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Backups (Fase 7 — ADR-010): dump lógico → R2 + validação cruzada ---------
# Discos de destino do dump (separados por vírgula; nomes de config/filesystems.php).
# Em dev: 'local' (storage/app/private/<APP_NAME>). Em produção: 'backup'
# (Cloudflare R2 — reutiliza as credenciais AWS_* acima).
BACKUP_DISKS=local
# Bucket R2 DEDICADO aos backups (vazio = usa AWS_BUCKET). Recomendado
# separar backups dos uploads em buckets distintos.
BACKUP_R2_BUCKET=
# Senha da CRIPTOGRAFIA do zip (AES-256) — OBRIGATÓRIA em produção
# (o dump contém o banco inteiro). Gerar: php artisan tinker → Str::random(64)
# Em APP_ENV=production o backup:run (e o agendamento) RECUSA rodar com ela
# vazia ou com valor de placeholder: termina com erro, grava no log e dispara
# o alerta de falha de backup. Em dev/local apenas avisa e segue.
BACKUP_ARCHIVE_PASSWORD=
# Opt-out consciente da recusa acima (só se a confidencialidade do backup for
# garantida por outra camada — bucket cifrado E de acesso restrito). Barulhento:
# cada execução grava aviso no log.
# BACKUP_ALLOW_UNENCRYPTED_IN_PRODUCTION=false
# Frequências (cron em UTC): dump / limpeza dos antigos (retenção) / health check.
BACKUP_RUN_CRON="0 * * * *"
BACKUP_CLEAN_CRON="30 2 * * *"
BACKUP_MONITOR_CRON="0 3 * * *"
# E-mail que recebe os alertas de FALHA (vazio = PLATFORM_SUPPORT_EMAIL).
BACKUP_ALERT_EMAIL=
# Webhook da validação cruzada produção→sandbox: URL privada do endpoint
# receptor no sandbox (contrato do payload no README, seção Backup).
# Vazio = webhook desativado.
BACKUP_WEBHOOK_URL=
# Health check do backup:monitor: idade máxima do backup mais recente (dias)
# e teto de armazenamento (MB) antes de alarmar.
BACKUP_MONITOR_MAX_AGE_DAYS=1
BACKUP_MONITOR_MAX_STORAGE_MB=5000

# --- Filas / Horizon (Fase 7 — ADR-010) ----------------------------------------
# Nome exibido no dashboard /horizon (vazio = padrão do pacote).
HORIZON_NAME=
# Processos simultâneos do supervisor em produção (config/horizon.php).
HORIZON_MAX_PROCESSES=10
# Processos do supervisor no ambiente local (mais leve que produção).
HORIZON_MAX_PROCESSES_LOCAL=3

# --- Uploads seguros (Fase 5 — ADR-010, checklist item 14) --------------------
# Disco padrão da função global de upload (SecureUploadService). Em produção
# use 's3' apontando para o R2 (acima); em dev, 'local'.
UPLOADS_DISK=local
# Diretório base dentro do disco quando o chamador não informa um.
UPLOADS_DIRECTORY=uploads
# Validade (minutos) das URLs temporárias assinadas — documentos NUNCA em
# bucket público; o acesso é sempre por URL assinada de curta duração.
UPLOADS_TEMPORARY_URL_MINUTES=15
# Tipos permitidos por padrão (chaves de config/uploads.php → types).
UPLOADS_ALLOWED_TYPES=image,pdf
# Tamanho máximo por tipo (KB) — o limite fino é por tipo, não global.
UPLOADS_IMAGE_MAX_KB=5120
UPLOADS_PDF_MAX_KB=10240
# Teto de pixels (largura×altura) antes de decodificar imagens na GD
# (proteção contra decompression bomb).
UPLOADS_IMAGE_MAX_PIXELS=25000000

# --- Segurança HTTP e logs de requisição (ADR-004/005/010) --------------------
# Headers de segurança OWASP (config/security.php).
SECURITY_HEADERS_ENABLED=true
# CSP básica — endurecer em produção (remover 'unsafe-inline' com nonces).
# SECURITY_CSP=
# CSPs DEDICADAS por rota (vazio = deriva da CSP base — Fase 6/7):
# /admin* precisa de 'unsafe-eval' (Filament 5 + bundle normal do Livewire);
# /horizon* precisa de 'unsafe-eval' + fonts.bunny.net (SPA Vue do dashboard).
# SECURITY_CSP_ADMIN=
# SECURITY_CSP_HORIZON=
# HSTS: enviado só sob HTTPS. Padrão: ligado quando APP_ENV=production.
# SECURITY_HSTS_ENABLED=

# Redirecionamento "de volta" (open redirect): o destino só é obedecido se for
# de MESMA ORIGEM que a APP_URL. Fallback quando não for, e origens extras
# legítimas (domínio com/sem www, staging, APP_URL em http atrás de borda https).
# SECURITY_REDIRECT_FALLBACK=/
# SECURITY_REDIRECT_ALLOWED_ORIGINS=https://www.exemplo.com,https://exemplo.com

# Segredos que não podem ser inventados: em APP_ENV=production a aplicação
# RECUSA subir sem uma APP_KEY própria (ausente, ou com valor de exemplo) e
# grava aviso no log quando DB_PASSWORD, REDIS_PASSWORD, API_KEYS_HASH_PEPPER,
# BACKUP_ARCHIVE_PASSWORD ou AWS_SECRET_ACCESS_KEY estão com valor de fachada.
# Esta lista é o vocabulário de "depois eu troco" reconhecido — acrescente os
# valores históricos da sua instalação. NÃO existe variável para desligar a
# recusa da chave. Ver App\Core\Support\CriticalSecrets.
# SECURITY_SECRETS_PLACEHOLDERS=troque-esta-senha,change-me,minha-senha-temporaria
#
# A recusa vale só onde chave errada causa dano: processo que SERVE tráfego
# (php-fpm) ou PROCESSA trabalho (lista abaixo). Comandos de instalação e
# manutenção (package:discover, config:cache, vendor:publish, migrate) apenas
# avisam — sem `.env` o Laravel considera APP_ENV=production, e recusar ali
# quebraria `composer install`. Aceita `*` no fim para worker próprio.
# SECURITY_SECRETS_PROCESSING_COMMANDS=queue:work,horizon,schedule:run,meu-worker:*

# Rate limiting (requisições por minuto).
# API: por CHAVE de API quando autenticada (RATE_LIMIT_API_BY=tenant soma as
# chaves do mesmo dono), por IP em rota sem autenticação (/api/health).
# Falhas de autenticação: 20/min por IP + chave pública (só aquela credencial,
# naquele IP, recebe 429) e teto de 100/min por IP somando todas — acima do
# teto, só passam as chaves que já autenticaram daquele IP (marca de 7 dias),
# para que o erro de um vizinho de NAT não derrube integração legítima.
RATE_LIMIT_API=60
# RATE_LIMIT_API_BY=key
# RATE_LIMIT_API_AUTH_FAILURES=20
# RATE_LIMIT_API_AUTH_FAILURES_PER_IP=100
# RATE_LIMIT_API_AUTH_FAILURES_DECAY_SECONDS=60
# RATE_LIMIT_API_AUTH_KNOWN_CLIENT_TTL_SECONDS=604800
RATE_LIMIT_SENSITIVE=5  # em dev local, o .env usa 30 para a suíte E2E paralela não esbarrar no throttle

# Teto por cliente da BORDA (App\Core\Security\Middleware\EdgeRateLimit): vale
# para TUDO que chega ao PHP — páginas, updates do Livewire, /admin, /up, API e
# rotas inexistentes (flood de 404) —, antes da varredura de ataque e da trilha
# em banco. Por IP (IPv6 por prefixo), porque roda antes da sessão. 300/min foi
# medido com folga para navegação normal e para a suíte E2E paralela; aumente
# para NAT grande (empresa, escola, CGNAT). Não há valor que desligue.
RATE_LIMIT_WEB=300
# RATE_LIMIT_WEB_DECAY_SECONDS=60
# RATE_LIMIT_IPV6_PREFIX=64

# Teto de bytes de texto (query + corpo; arquivo conta só pelos metadados) que a
# detecção de ataque inspeciona. Acima dele: 413 + registro BLOQUEADA
# (payload_too_large). O excedente nunca é aceito sem inspeção.
# SECURITY_VALIDATION_MAX_INSPECTED_BYTES=1048576

# Contenção da trilha em banco: de cada cliente, só a PRIMEIRA requisição a rota
# inexistente (404/405) e a PRIMEIRA recusa 429 por janela viram linha em
# request_logs; o resto fica no log de arquivo. Ataques bloqueados e rotas que
# existem (autenticadas ou não) são gravados SEMPRE. 0 = sem amostragem.
# REQUEST_LOG_SCAN_SAMPLE_WINDOW_SECONDS=60

# --- Quem pode dizer QUEM É O CLIENTE, e qual é o HOST -------------------------
# Atrás de qualquer borda (o nginx deste compose, um load balancer, uma CDN) o
# php-fpm só vê a conexão do proxy. Quem obedece `X-Forwarded-For`/`-Proto` é
# esta declaração — regra inteira em App\Core\Http\TrustedProxies e na seção
# "Proxies confiáveis e host confiável" do README.
#
# PADRÃO: VAZIO = NENHUM proxy confiável. Os headers de encaminhamento são
# IGNORADOS e `ip()` é o endereço da conexão. Atrás de proxy isso é o IP do
# proxy (errado, mas não inseguro: ninguém consegue se declarar outra pessoa).
# Em desenvolvimento é o IP do container do nginx, e não faz diferença.
#
# Para declarar, use uma lista ESTREITA de IP exato ou faixa CIDR (IPv4/IPv6):
#   nginx deste compose (rede interna do Docker) → private
#     (faixas privadas + loopback; seguro aqui porque a porta 9000 do php-fpm
#     não é publicada — numa rede interna compartilhada com terceiros, estreite)
#   load balancer na frente do nginx             → private,10.20.0.0/16
#   Cloudflare na borda                          → private + as faixas de
#     https://www.cloudflare.com/ips/ (escritas explicitamente, revistas no
#     deploy) e a origem fechada por firewall para só aceitar a Cloudflare.
# `*` (confiar em qualquer origem) NUNCA é padrão: é opt-out declarado e grava
# aviso no log a cada boot em produção.
TRUSTED_PROXIES=

# Obedecer também X-Forwarded-Host? Padrão NÃO (diferente do padrão do Laravel):
# esse header reescreve o host da aplicação, e o host monta toda URL absoluta
# gerada. Ligue só quando a aplicação é servida num host interno e publicada em
# outro — e declare esse host em TRUSTED_HOSTS. Ver App\Core\Http\TrustedProxies.
# TRUSTED_PROXY_TRUST_FORWARDED_HOST=true

# Hosts aceitos ALÉM do host da APP_URL (que já entra sozinho, com os
# subdomínios dele; `localhost`, `127.0.0.1` e `[::1]` são sempre aceitos, para
# sondas e healthchecks). Host exato ou `*.dominio`, sem porta. Um `Host` fora da
# lista recebe 400 antes de virar URL: foi assim que
# `curl -H "Host: evil.example.com" .../dashboard` parou de responder
# `Location: http://evil.example.com/login`.
#
# A validação vale em TODO ambiente, desenvolvimento incluído. Se você acessa o
# kit por outro nome além de localhost (IP do WSL, `kit.test`), declare-o aqui.
# TRUSTED_HOSTS=www.exemplo.com,*.staging.exemplo.com

# --- Superfícies administrativas: /admin e /horizon (Fase 6 — ADR-011) --------
# Origens permitidas nas duas. Aceita IP exato, faixa CIDR IPv4
# (198.51.100.0/24) e IPv6 com ou sem prefixo (2001:db8::1, 2001:db8::/32),
# separados por vírgula — espaços em volta são aparados.
#
# VAZIO AQUI = sem restrição, porque este é o arquivo de DESENVOLVIMENTO: o IP
# de quem desenvolve é o que o Docker/WSL/CI resolver dar, e não há segredo
# atrás do /admin de dev.
#
# EM PRODUÇÃO, VAZIO = RECUSA: com APP_ENV=production, o /admin e o /horizon
# respondem 403 enquanto a origem permitida for desconhecida, e o log diz o que
# falta e como voltar. O resto da aplicação (site, API, painel do usuário, filas
# e /up) segue atendendo. Antes, vazio liberava qualquer origem enquanto a
# documentação prometia que a allowlist era obrigatória.
#
# NUNCA coloque aqui o IP do proxy/load balancer: todas as requisições chegam
# com aquele endereço e a barreira ficaria aberta para a internet inteira,
# parecendo configurada. Ver App\Core\Security\AdminIpAllowlist.
ADMIN_ALLOWED_IPS=

# ESCAPE HATCH: assume a ausência de allowlist na aplicação como decisão
# declarada, em vez de recusa em produção. Só para quem administra de IP
# dinâmico ou já tem a segunda barreira fora da aplicação (VPN, Cloudflare
# Access, WAF). Grava aviso no log a cada boot enquanto estiver valendo.
# ADMIN_ALLOW_ANY_IP=true

# CORS restritivo: origens permitidas separadas por vírgula.
# Vazio = NENHUMA origem (API server-to-server). Liberar só as origens dos painéis.
CORS_ALLOWED_ORIGINS=
CORS_MAX_AGE=600

# Rotas excluídas do request log em banco (health checks — seguem no access log
# do nginx). Separadas por vírgula, padrão do Request::is().
REQUEST_LOG_EXCLUDED_PATHS=up,api/health,favicon.ico,build/*,storage/*,vendor/*
# Rotas registradas com payload RESUMIDO (updates genéricos do Livewire — o
# snapshot serializado é ruído de transporte; o log guarda só os componentes).
REQUEST_LOG_SUMMARIZED_PATHS=livewire/*,livewire-*,admin/livewire/*
# Marcador gravado no lugar do endpoint quando NENHUMA rota casa (404,
# varredura). O caminho real nunca é gravado — pode carregar segredo no path.
REQUEST_LOG_UNMATCHED_ENDPOINT=[unmatched]
# Tamanho máximo da correlação enviada pelo CLIENTE no header X-Correlation-Id
# (gravada em coluna própria, sem unicidade). Teto da coluna: 255.
REQUEST_LOG_CLIENT_CORRELATION_MAX_LENGTH=128
# Dias de retenção do canal de arquivo storage/logs/request-YYYY-MM-DD.log.
REQUEST_LOG_DAYS=30

# --- Landing pública, showcase /ui e login demo --------------------------------
# Números que a landing oficial (/) exibe como PROVA. Todos podem ser zerados:
# zero ESCONDE o elemento — um número inventado é pior do que número ausente.
# Quantos desenvolvedores já clonaram o repositório (0 = mostra a suíte verde).
LANDING_CLONES=0
# Testes verdes da suíte. Confira com `php artisan test` antes de mexer.
LANDING_TESTS=698
# Horas de trabalho que a base já entrega feitas (soma do inventário do kit).
LANDING_HOURS_SAVED=280
# 3D em tempo real no herói e no rodapé (Three.js). false = fallback em CSS.
LANDING_WEBGL=true
# ATENÇÃO — como a demonstração é protegida (leia antes de mexer nas flags):
#
# Todas as flags desta seção são a SEGUNDA barreira, não a única. Em
# APP_ENV=production a superfície de demonstração é recusada MESMO COM AS FLAGS
# LIGADAS: as rotas /ui, POST /ui/form-demo e /mail-preview respondem 404, as
# credenciais demo não aparecem nem são pré-preenchidas em nenhuma tela de
# login, e os seeders de dado fictício se recusam a rodar (o DatabaseSeeder
# avisa e passa; um seeder demo chamado direto lança exceção). Quem decide é
# app/Core/Support/DemoSurface.php.
#
# ESCAPE HATCH — demo pública hospedada em produção (prevista no roadmap):
# é o único caso legítimo de demonstração rodando em produção, e ele tem de ser
# DECLARADO. Descomentar a linha abaixo libera tudo o que está descrito acima e
# faz a aplicação gravar um aviso no log a cada boot. Ligue isto apenas numa
# instalação DESCARTÁVEL: o banco é público, as credenciais são públicas e
# qualquer visitante é super admin.
# DEMO_ALLOW_IN_PRODUCTION=true

# Showcase de componentes UI em /ui (documentação viva do kit). Padrão: ligado
# em local. EM PRODUÇÃO: a rota responde 404 mesmo com esta flag em true.
UI_SHOWCASE_ENABLED=true
# Login demo (fricção zero em dev): pré-preenche credenciais conhecidas na tela
# de login e o DatabaseSeeder cria o usuário demo (DemoUserSeeder). A mesma
# flag governa a galeria de e-mails /mail-preview.
# Padrão: ligado em local. Em produção esta flag NÃO É OBEDECIDA (ver acima).
# As senhas demo obedecem à MESMA política do app (AUTH_PASSWORD_*) e
# passam mesmo com todas as regras ligadas — senha demo que não passa na
# própria validação vira armadilha (bug de QA #6).
DEMO_LOGIN_ENABLED=true
DEMO_USER_EMAIL=demo@tws.dev
DEMO_USER_PASSWORD=Demo-password1
# Super admin demo (/admin): mesma flag DEMO_LOGIN_ENABLED. A senha abaixo é
# PÚBLICA (está neste arquivo, que é versionado): é uma credencial de vitrine,
# nunca de instalação real. Em produção a conta não é criada e as credenciais
# não são pré-preenchidas no login do Filament.
DEMO_ADMIN_EMAIL=admin@tws.dev
DEMO_ADMIN_PASSWORD=Demo-admin-password1
# Estratégia de exibição de erros de validação (config/ui.php):
# inline (padrão) | summary | toast | both — override por form via prop.
UI_ERROR_DISPLAY=inline

# --- Dashboards do super admin (/admin — config/dashboards.php) ----------------
# O kit entrega TRÊS dashboards nomeados para o desenvolvedor escolher a base
# que mais lhe agrada: overview (Visão geral), growth (Crescimento & API) e
# content (Conteúdo & Operação). Tirar um slug da lista remove a variante do
# MENU e da ROTA (a página deixa de ser registrada — 404, não item escondido).
DASHBOARD_ENABLED=overview,growth,content
# Qual variante responde em /admin. As demais ficam em /admin/dashboards/{slug}.
# Slug desligado aqui = a primeira variante habilitada assume a home.
DASHBOARD_DEFAULT=overview
# Janela padrão do seletor de período (7, 30 ou 90 dias).
DASHBOARD_PERIOD=30
# Meta mensal de requisições (widget de progresso da variante "growth").
# Meta é parâmetro de operação, não dado de domínio — por isso vive no .env.
DASHBOARD_GOAL_MONTHLY_REQUESTS=1500
# Quantas linhas as tabelas de "últimos registros" dos dashboards mostram.
DASHBOARD_LATEST_RECORDS=6

VITE_APP_NAME="${PLATFORM_NAME}"

<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- force + server: os containers Docker injetam APP_ENV=local via
             env_file (.env), e o Laravel lê $_SERVER primeiro. Sem isto, o
             ambiente de teste NÃO é testing (CSRF fica ativo etc.). -->
        <env name="APP_ENV" value="testing"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!-- Argon2id com parâmetros mínimos nos testes (velocidade) — o
             ALGORITMO é o mesmo da produção, só o custo é menor. -->
        <env name="ARGON_MEMORY" value="1024"/>
        <env name="ARGON_THREADS" value="1"/>
        <env name="ARGON_TIME" value="1"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <!-- $_SERVER precisa bater com o env acima: os containers Docker injetam
             DB_* do .env via env_file, e o Laravel lê $_SERVER primeiro. -->
        <server name="DB_CONNECTION" value="sqlite" force="true"/>
        <server name="DB_DATABASE" value=":memory:" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <!-- Idem cache: o rate limiter usa a store default; Redis persistiria
             os contadores ENTRE testes, tornando-os dependentes de ordem. -->
        <server name="CACHE_STORE" value="array" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>

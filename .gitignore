# Raiz do monorepo: só o que vale para o repositório inteiro.
# Cada starter tem o próprio .gitignore (ex.: starters/livewire/.gitignore),
# com os caminhos relativos à pasta dele.

# Sistema e editores
.DS_Store
Thumbs.db
*.log
/.idea
/.vscode
/.zed
/.cursor/
/.codex
/.nova

# Arquivo de ambiente, em qualquer pasta: segredo nunca é versionado.
.env

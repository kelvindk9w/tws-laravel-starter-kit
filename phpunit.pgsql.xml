<?xml version="1.0" encoding="UTF-8"?>
<!--
    Suíte contra PostgreSQL de verdade (o banco de produção). O CI roda com
    este arquivo; o phpunit.xml (SQLite em memória) continua sendo o comando
    padrão local, que não exige banco nenhum.

    Diferenças para o phpunit.xml: só DB_CONNECTION e DB_DATABASE. Host,
    porta, usuário e senha vêm do ambiente (no container `app` do dev, do
    .env; no CI, das variáveis do job).

    O nome do banco é FORÇADO para `tws_starter_test`: a suíte apaga o banco
    a cada execução e nunca pode apontar para o banco de desenvolvimento do
    .env. A tests/TestCase.php recusa qualquer banco cujo nome não termine
    em _test. Para criar o banco de teste no Postgres do docker de dev, ver
    docs/testes.md ("Testes contra o PostgreSQL").

        docker compose exec app ./vendor/bin/pest -c phpunit.pgsql.xml
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- force + server: os containers Docker injetam APP_ENV=local via
             env_file (.env), e o Laravel lê $_SERVER primeiro. Sem isto, o
             ambiente de teste NÃO é testing (CSRF fica ativo etc.). -->
        <env name="APP_ENV" value="testing"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!-- Argon2id com parâmetros mínimos nos testes (velocidade) — o
             ALGORITMO é o mesmo da produção, só o custo é menor. -->
        <env name="ARGON_MEMORY" value="1024"/>
        <env name="ARGON_THREADS" value="1"/>
        <env name="ARGON_TIME" value="1"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Único ponto que difere do phpunit.xml. -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="tws_starter_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <!-- $_SERVER precisa bater com o env acima: os containers Docker injetam
             DB_* do .env via env_file, e o Laravel lê $_SERVER primeiro. -->
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_DATABASE" value="tws_starter_test" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <!-- Idem cache: o rate limiter usa a store default; Redis persistiria
             os contadores ENTRE testes, tornando-os dependentes de ordem. -->
        <server name="CACHE_STORE" value="array" force="true"/>
        <!-- Modo demo DESLIGADO na suíte, independente do .env: com ele ligado
             (o .env.example liga), a migration instala o gatilho das contas demo
             no banco de teste do PostgreSQL e ele fica valendo para a suíte
             inteira. Os testes que precisam do modo demo ligam por config() e
             instalam o gatilho eles mesmos (DemoAccountHardeningTest). -->
        <env name="DEMO_LOGIN_ENABLED" value="false" force="true"/>
        <server name="DEMO_LOGIN_ENABLED" value="false" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>

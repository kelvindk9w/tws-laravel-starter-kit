# =============================================================================
# Contexto de build `packages` da imagem de produção (ver
# starters/livewire/docker/php/Dockerfile): o que dos pacotes NUNCA vai para a
# imagem. O Composer copia o pacote inteiro para vendor/, então tudo o que é
# de desenvolvimento do pacote fica de fora aqui.
# =============================================================================
*/vendor
*/composer.lock
*/tests
*/phpunit.xml
*/.phpunit.cache
*/.phpunit.result.cache
*/.gitignore
*/.gitattributes

# A DEMONSTRAÇÃO do kit (twstec/kit-demo) é pacote de desenvolvimento
# (require-dev do starter): a imagem de produção (`composer install --no-dev`)
# não a instala, e o código dela nem entra no contexto do build.
demo

# O INSTALADOR (twstec/kit-installer, o `php artisan tws:install`) também é
# de desenvolvimento (require-dev): fica fora da imagem pelo mesmo motivo.
installer

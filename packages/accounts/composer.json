{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "twstec/kit-accounts",
    "description": "Contas e API do TWS Laravel Starter Kit, sem telas: projetos, chaves de API com par pública/secreta, hash com pepper, escopos, vínculo chave-projeto, rotação com período de graça, expiração por inatividade, autenticação e limites da API e a API v1.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "api-keys", "tenancy", "api", "starter-kit"],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.17",
        "twstec/kit-auth": "2.x-dev",
        "twstec/kit-foundation": "2.x-dev"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.7"
    },
    "autoload": {
        "psr-4": {
            "Twstec\\Kit\\Accounts\\": "src/"
        },
        "files": [
            "src/Compat/legacy-aliases.php",
            "src/Tenancy/helpers.php",
            "src/ApiKeys/Mail/previews.php",
            "src/Account/Mail/previews.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Twstec\\Kit\\Accounts\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Twstec\\Kit\\Accounts\\AccountsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../auth",
            "options": {
                "versions": {
                    "twstec/kit-auth": "2.x-dev"
                },
                "reference": "config"
            }
        },
        {
            "type": "path",
            "url": "../foundation",
            "options": {
                "versions": {
                    "twstec/kit-foundation": "2.x-dev"
                },
                "reference": "config"
            }
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.4.24"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

<?xml version="1.0" encoding="UTF-8"?>
<!--
    Suíte do twstec/kit (o comando único). Nada aqui baixa pacote: o Composer
    é de mentira (tests/Fixtures/FakeRunner) e o projeto é uma pasta
    temporária; o menu roda com as teclas de mentira do Laravel Prompts.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>kit-setup/src</directory>
        </include>
    </source>
</phpunit>

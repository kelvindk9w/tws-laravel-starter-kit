# =============================================================================
# TWS Laravel Starter Kit — .env.prod.example (PRODUÇÃO)
#
# Copie para .env.prod. Este arquivo é injetado como VARIÁVEIS DE AMBIENTE
# diretamente nos containers (env_file do compose) — use os nomes do Laravel.
#
# ATENÇÃO: o compose interpola ${PROD_*} a partir do shell ou do .env da raiz
# (não deste arquivo). Para trocar portas/senhas padrão da stack de produção,
# defina PROD_* no shell ao rodar o compose, ex.:
#   PROD_POSTGRES_PASSWORD=xyz PROD_REDIS_PASSWORD=abc \
#     docker compose -f docker-compose.prod.yml up -d
# =============================================================================

# Obrigatória em produção real (gerar com: php artisan key:generate --show).
# Sem ela, cada container gera uma chave efêmera própria na subida (apenas
# para teste da stack — NÃO usar assim de verdade).
APP_KEY=

# Painéis (Fase 6): a cor da marca e a IP allowlist do /admin entram no
# mapeamento do compose como PROD_PLATFORM_PRIMARY_COLOR e
# PROD_ADMIN_ALLOWED_IPS (definir no shell ou no .env da raiz ao subir).
# ATENÇÃO (ADR-011): PROD_ADMIN_ALLOWED_IPS é OBRIGATÓRIA em produção.

# Credenciais extras que não entram no mapeamento padrão do compose
# (entram direto nos containers via env_file — use os nomes do Laravel):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT=
# AWS_BUCKET=
# MAIL_USERNAME=
# MAIL_PASSWORD=
#
# Chaves de API e uploads (Fases 4/5) — produção real:
# API_KEYS_ENVIRONMENT=live        # pk_live_/sk_live_
# API_KEYS_HASH_PEPPER=            # segredo dedicado (tinker → Str::random(64))
# UPLOADS_DISK=s3                  # uploads → R2 (bucket NUNCA público)
#
# Backups (Fase 7 — ADR-010): dump lógico criptografado → Cloudflare R2.
# ATENÇÃO: BACKUP_ARCHIVE_PASSWORD é OBRIGATÓRIA em produção (o dump contém
# o banco inteiro) e BACKUP_WEBHOOK_URL é o gatilho da validação cruzada
# produção→sandbox (contrato do payload no README, seção Backup).
# BACKUP_DISKS=backup
# BACKUP_R2_BUCKET=
# BACKUP_ARCHIVE_PASSWORD=
# BACKUP_ALERT_EMAIL=
# BACKUP_WEBHOOK_URL=
#
# Horizon (Fase 7): processos do supervisor de filas (serviço `horizon`).
# HORIZON_MAX_PROCESSES=10
#
# Landing pública, showcase /ui e login demo — em produção, SEMPRE desligados:
# o showcase expõe superfície desnecessária e o login demo seria uma backdoor.
# UI_SHOWCASE_ENABLED=false
# DEMO_LOGIN_ENABLED=false
